{
  "name": "functions",
  "description": "Trusted server-side workflows through typed Rayfin user-defined functions, including external APIs, custom model endpoints, and Fabric data-agent calls.",
  "packageJson": "packages/frontend/package.json",
  "dependencies": {
    "@rayfin-app/functions": "*"
  },
  "rayfin": {
    "services": {
      "functions": {
        "enabled": true,
        "path": "packages/functions",
        "buildCommand": "npm run build",
        "auth": {
          "type": "application"
        }
      }
    }
  },
  "scripts": {
    "functions:build": "npm run -w @rayfin-app/functions build",
    "validate:functions": "npm run -w @rayfin-app/shared build && node scripts/validate-functions.mjs"
  },
  "scriptStages": {
    "build": [
      "npm run -w @rayfin-app/shared build",
      "node scripts/validate-functions.mjs",
      "npm run -w @rayfin-app/functions build"
    ],
    "build:fabric": [
      "npm run -w @rayfin-app/shared build",
      "node scripts/validate-functions.mjs",
      "npm run -w @rayfin-app/functions build"
    ],
    "typecheck": [
      "npm run -w @rayfin-app/shared build",
      "node scripts/validate-functions.mjs",
      "npm run -w @rayfin-app/functions build"
    ]
  },
