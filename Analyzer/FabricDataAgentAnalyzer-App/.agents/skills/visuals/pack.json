{
  "name": "visuals",
  "description": "Charts and tables: Vega-Lite specs rendered by <VegaVisual>, tabular data by <DataGrid>, `toDataTable` for feeding either from a query result, and an offline validator that checks readable specs for structural errors before they ship.",
  "packageJson": "packages/frontend/package.json",
  "dependencies": {
    "@microsoft/fabric-datagrid": "1.3.0",
    "@microsoft/fabric-visuals": "1.3.0",
    "@microsoft/fabric-visuals-core": "1.3.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "vega-lite": "^6.4.3",
    "yaml": "2.9.0"
  },
  "scripts": {
    "validate:visual": "node scripts/validate-visual.mjs",
    "validate:visual:preview": "node scripts/validate-visual.mjs --allow-incomplete"
  },
  "copy": [
    { "from": "kit/lib", "to": "packages/frontend/src/lib" },
    {
      "from": "kit/scripts/validate-visual.mjs",
      "to": "scripts/validate-visual.mjs",
      "seedReplaceIfPristine": [
        "a2d0824a4d1985e10d2ec32a02cb2a6b25d54c58a5d3e7efb22d1c9a5036ca97",
        "53e1ba7c1dd2a4eb96cfe7dbc3935ddc13a300744db69a0a2ca9ad7fd1d5d95f",
        "6d5147b8107110c4b122d70e30c546dc118bd4ab652ddc5240408d172f3b5115"
      ]
    }
  ],
  "next": ["visuals", "app-design"]
}
